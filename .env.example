# ---------------------------------------------------------------
#  سورین — سامانه پشتیبانی
#  این فایل را به .env کپی کنید و مقادیر را تنظیم کنید.
#  فایل .env هرگز نباید روی گیت کامیت شود.
# ---------------------------------------------------------------

APP_NAME="سامانه پشتیبانی سورین"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost:8080
APP_LOCALE=fa
APP_PORT=8080
PMA_PORT=8081

# --- برندینگ (در فوتر و سربرگ فاکتور استفاده می‌شود) ---
COMPANY_NAME="سورین"
COMPANY_NAME_EN="Soorin"
COMPANY_WEBSITE=https://yoursite.com
COMPANY_FOUNDED_YEAR=1400
COMPANY_PHONE=
COMPANY_ADDRESS=

# --- دیتابیس ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=soorin_support
DB_USERNAME=soorin
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME_TOO

# --- حالت اجرا ---
# روی سرور با Docker:      redis
# روی هاست اشتراکی (DirectAdmin/cPanel/XAMPP):  database
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379

FILESYSTEM_DISK=local
LOG_CHANNEL=daily
LOG_LEVEL=warning
