# نسخه مخصوص هاست اشتراکی DirectAdmin / cPanel / XAMPP — بدون Docker و بدون Redis
APP_NAME="سامانه پشتیبانی سورین"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://support.yoursite.com
APP_LOCALE=fa

# برندینگ از صفحهٔ «شخصی‌سازی» داخل پنل تنظیم می‌شود، نه از این فایل.

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

FILESYSTEM_DISK=local
LOG_CHANNEL=daily
LOG_LEVEL=error
